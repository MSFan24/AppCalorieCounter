<Window x:Class="AppCalorieCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppCalorieCounter"
        xmlns:vm="clr-namespace:AppCalorieCounter.ViewModel"
        xmlns:lc1="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      
        mc:Ignorable="d"
        Title="Приложение по расчету каллорий" Height="780" Width="1100" WindowStartupLocation="CenterScreen" >

    <Window.DataContext>
        <vm:ViewModel/>
    </Window.DataContext>

    <Grid>
        <!--Меню-->
        <Menu Width="120" Height="20"  VerticalAlignment="Top" HorizontalAlignment="Left">
            <MenuItem Header="Фаил" Height="20" Width="50"></MenuItem>
            <MenuItem Header="Помощь"></MenuItem>
        </Menu>
        <!--Вкладки-->
        <TabControl Margin="0,18,0,0" >
            <!--Вкладки 1-->
            <TabItem Header="Стартовое меню"  >
                <Grid Background="Green" Height="627" Margin="0,0,-1,0">

                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" Text="Для того чтобы приступить к работе выберете одну из вкладок согласно вашим целям" Grid.ColumnSpan="2" Margin="217,0,0,0"/>
                </Grid>
            </TabItem>
            <!--Вкладки 2-->
            <TabItem Header="Расчет калорий в продукте" >
                <TabControl>
                    <!--Вкладки Обзор Мои продукты-->
                    <TabItem Header ="Обзор Мои продукты">
                        <Grid Background="LemonChiffon" Height="647">
                            <DataGrid  x:Name="DataGrid_1" AutoGenerateColumns="False" ItemsSource="{Binding OBProducts}" SelectedItem="{ Binding VM_SelectedProductinDataGrid_1}" Height="415" VerticalAlignment="Top">
                                <DataGrid.Columns >
                                    <DataGridCheckBoxColumn Header="Выбрать" Binding="{Binding IsSelected}" />
                                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="35" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Продукт" Binding="{Binding Name}"  Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Каллорийность на 100 грамм/мл продукта" Binding="{Binding Caloric_in_100_units_of_mass}" IsReadOnly="True"  Width="*"/>
                                    <DataGridTextColumn Header="Объем/масса продукта" Binding="{Binding Product_quantity }" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Система измерения"  Width="130" Binding="{Binding Measurement_system}" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40"><Run Text="Вкладка 2.1"/><LineBreak/><Run/></TextBlock>
                            <Grid Background="DarkOrchid" Margin="10,435,10,42">
                                <!--Название продукта -->
                                <TextBlock  Margin="0,0,858,115" HorizontalAlignment="Right" VerticalAlignment="Bottom"  Width="200" Height="34" Text="Название продукта" TextAlignment="Center"   Background="LightSeaGreen"/>
                                <TextBox  Text="{Binding  VM_ProductName, UpdateSourceTrigger=PropertyChanged}"  Margin="10,76,0,0"  TextAlignment="Center"  Background="LightYellow" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Width="200"/>
                                <!--Калорийность на 100 ... -->
                                <TextBlock  Margin="215,0,0,115" HorizontalAlignment="Left" VerticalAlignment="Bottom"  Width="200" Height="34" Text="Калорийность на 100 ..."  Background="LightSeaGreen" TextAlignment="Center"/>
                                <TextBox  Text="{Binding VM_ProductCallIn100, UpdateSourceTrigger=PropertyChanged}" Margin="215,75,0,0"  TextAlignment="Center"  Background="LightYellow" HorizontalAlignment="Left" Width="200" Height="30" VerticalAlignment="Top"/>
                                <!--Объем/масса продукта -->
                                <!--
                                <TextBlock Margin="420,21,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"  Width="200" Height="34" Text="Объем/масса продукта" TextAlignment="Center"  Background="LightSeaGreen"/>
                                <TextBox  Text="{Binding ProductQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="420,76,0,0"  TextAlignment="Center"  Background="LightYellow" HorizontalAlignment="Left" Width="200" Height="30" VerticalAlignment="Top"/>-->
                                <!--Система измерения -->
                                <TextBlock Margin="420,21,0,0" HorizontalAlignment="Left"  Width="200" Height="34" TextAlignment="Center"  Background="LightSeaGreen" VerticalAlignment="Top"><Run Text="Система измерения"/><LineBreak/><Run/><Run Language="ru-ru" Text=" (по умолчанию в граммах)"/></TextBlock>
                                <CheckBox IsChecked="{Binding VM_MeasurementSystemIsChecked, UpdateSourceTrigger=PropertyChanged}" Content="Mл" Margin="500,80,0,0" Height="20" Width="40" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <!--Кнопки добавить изменить удалить продукт-->
                                <Button Background="Bisque" Margin="10,0,858,10" Content="Добавить" Command="{Binding AddNewProductInDBCommand}" Height="30" VerticalAlignment="Bottom"/>
                                <Button Background="Bisque" Margin="215,0,653,10" Content="Изменит" Command="{Binding СhangerProducInDBCommand}" Height="30" VerticalAlignment="Bottom" />
                                <Button Background="Bisque" Margin="420,130,448,10" Height="30" Command="{Binding DeleteProducInDBCommand}" Content="Удалить"/>
                                <Button Background="Bisque" Margin="625,130,10,10" Height="30" Command="{Binding Transferring_selected_products_to_another_table_Command}" Content="Перенести выбранные продукты в отдельную табоицу для расчетов"/>
                            </Grid>
                            <TextBlock HorizontalAlignment="Left" Margin="10,618,0,0" TextWrapping="Wrap" Text="{Binding TexBlockProgress}" VerticalAlignment="Top" Height="19"  Width="414"/>
                        </Grid>

                    </TabItem>
                    <!--Вкладки Выбранные продукты -->
                    <TabItem Header="Выбранные продукты">
                        <Grid>
                            <DataGrid Background="LightBlue" x:Name="DataGrid_2" AutoGenerateColumns="False" ItemsSource="{Binding OBSelektProduct}" SelectedItem="{ Binding VM_SelectedProductinDataGrid_2}" Margin="0,0,354,159">
                                <DataGrid.Columns >
                                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="35" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Продукт" Binding="{Binding Name}"  Width="60" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Каллорийность на 100 грамм/мл" Binding="{Binding Caloric_in_100_units_of_mass}" IsReadOnly="True"  Width="*"/>
                                    <DataGridTextColumn Header="Объем/масса продукта" Binding="{Binding Product_quantity }" Width="140" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Калорийность объема продукта" Binding="{Binding Calories_in_product_of_specified_weight }" Width="*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Background="Gold" Margin="0,536,0,0">
                                <Button Content="Построить диаграмму калорийности для выбранных продуктов" Command="{Binding Method_constructing_pie_chart_of_colorCommand}" Margin="244,33,244,24"/>
                            </Grid>
                            <Grid Background="Gold" Margin="739,21,0,159">
                                <TextBlock Background="Red" Height="30" Width="300" Margin="0,51,0,0" Text="Введите количество употребляемого продукта " TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <TextBox   Margin="0,91,0,0" Height="30" Width="300"  Text="{Binding VM_ProductQuantity }" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center"/>
                                <Button Margin="0,136,0,0" Height="25" Width="300"  Content="Нажать" Command="{Binding Method_entering_caloric_content_in_productCommand}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Диаграмма калорийности">
                        <Grid>
                            <TextBlock Margin="394,15,354,460" TextWrapping="Wrap" TextAlignment="Center" LineHeight="11" ><Run Language="ru-ru" Text="Нормальная среднесуточная калорийнось обычного человека = 2000 кк.Привышение этого показателя видет к повышению веса"/></TextBlock>
                            <lc1:PieChart StartingRotationAngle="0" LegendLocation="Bottom" Series="{Binding PieSeries }" Margin="314,105,274,105" />


                        </Grid>
                    </TabItem>
                </TabControl>

            </TabItem>
            <!--Вкладки 3-->
            <TabItem Header="Расчет калорийности для целей">
                <Grid Background="Red">
                    <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Text="Вкладка 3"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
