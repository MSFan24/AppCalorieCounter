<Window x:Class="AppCalorieCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppCalorieCounter"
        mc:Ignorable="d"
        Title="Приложение по расчету каллорий" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <!--Меню-->
        <Menu Width="120" Height="20"  VerticalAlignment="Top" HorizontalAlignment="Left">
            <MenuItem Header="Фаил" Height="20" Width="50"></MenuItem>
            <MenuItem Header="Помощь"></MenuItem>
        </Menu>
        <!--Вкладки-->
        <TabControl  Width="800" Height="416" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,18,0,0" >
            <!--Вкладки 1-->
            <TabItem Header="Стартовое меню"  >
                <Grid Background="Green">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Text="Для того чтобы приступить к работе выберете одну из вкладок согласно вашим целям"/>
                </Grid>
            </TabItem>
            <!--Вкладки 2-->
            <TabItem Header="Расчет калорий в продукте" >
                <!--Вкладки 2.1 -->
                <TabControl>
                    <TabItem Header ="Добавление в Мои продукты">
                        <Grid Background="Yellow">
                            <StackPanel  Margin="10,0,0,0" Height="340 " Width="200" VerticalAlignment="Center" HorizontalAlignment="Left" Background="MediumPurple">
                                <!--Название продукта -->
                                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"  Width="200" Height="20" Text="Название продукта" TextAlignment="Center"   Background="LightSeaGreen"/>
                                <TextBox Margin="0,10,0,0"  TextAlignment="Center"  Background="LightYellow" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Width="200"/>
                                <!--Калорийность на 100 ... -->
                                <TextBlock  Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"  Width="200" Height="20" Text="Калорийность на 100 ..."  Background="LightSeaGreen" TextAlignment="Center"/>
                                <TextBox  Margin="0,10,0,0"  TextAlignment="Center"  Background="LightYellow" HorizontalAlignment="Left" Width="200" Height="30" VerticalAlignment="Top"/>
                                <!--Объем/масса продукта -->
                                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"  Width="200" Height="20" Text="Калорийность на 100 ..." TextAlignment="Center"  Background="LightSeaGreen"/>
                                <TextBox  Margin="0,10,0,0"  TextAlignment="Center"  Background="LightYellow" HorizontalAlignment="Left" Width="200" Height="30" VerticalAlignment="Top"/>
                                <!--Система измерения -->
                                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"  Width="200" Height="20" Text="Система измерения" TextAlignment="Center"  Background="LightSeaGreen"/>
                                <StackPanel  Width="200" Height="51" Orientation="Horizontal">
                                    <CheckBox  Content="Mл" Margin="40,0,0,0" Height="20" Width="40"  VerticalAlignment="Center" />
                                    <CheckBox  Content="Грамм" Margin="40,0,0,0" Height="20" Width="57"  VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Width="200" Height="40" Content="Добавить продукт"/>

                            </StackPanel>
                            <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Text="Вкладка 2.1"/>
                        </Grid>
                    </TabItem>
                    <!--Вкладки 2.2 -->
                    <TabItem Header ="Обзор Мои продукты">
                        <Grid Background="Blue">
                            <DataGrid  Height="300" VerticalAlignment="Top" AutoGenerateColumns="False">>
                                <DataGrid.Columns >
                                    <DataGridCheckBoxColumn Header="Выбрать" />
                                    <DataGridTextColumn Header="Id" />
                                    <DataGridTextColumn Header="Продукт" Width="*"/>
                                    <DataGridTextColumn Header="Объем/масса продукта" Width="*"/>
                                    <DataGridTextColumn Header="Система измерения" Width="*"/>
                                </DataGrid.Columns>
                        
                            </DataGrid>
                            
                            <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Text="Вкладка 2.2"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <!--Вкладки 3-->
            <TabItem Header="Расчет калорийности для целей">
                <Grid Background="Red">
                    <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Text="Вкладка 3"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
